# Copy to .env.local and fill in from Back4App: App Settings > Security & Keys.
# These two keys are safe to ship in the app. Never put the Master Key here.
EXPO_PUBLIC_BACK4APP_APP_ID=
EXPO_PUBLIC_BACK4APP_JS_KEY=
# Optional, defaults to https://parseapi.back4app.com
# EXPO_PUBLIC_BACK4APP_SERVER_URL=
